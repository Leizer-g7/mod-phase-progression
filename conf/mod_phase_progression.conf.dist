############################################
# PHASE PROGRESSION
############################################

Progression.Enable = 1

#
# Fase inicial utilizada cuando todavía no existe
# estado persistido en la base de datos.
#
# Valores válidos:
# 20, 30, 40, 50, 60, 70, 80
#

Progression.ActivePhase = 20

#
# Estado histórico/content tier global.
# Se persiste en phase_progression_state.
# Rango global: 0..18
#

Progression.ActiveContentStage = 0

#
# Permitir bajar una fase.
# PRODUCCIÓN: dejar en 0
#

Progression.AllowPhaseRollback = 0

#
# Permitir que personajes GM ignoren caps.
#

Progression.GMBypass = 1


############################################
