#
# BATTLEGROUND PHASE AUTOMATION
#

# Permite que mod-phase-progression controle el auto-join de BGs.
Progression.Battlegrounds.Enabled = 1

# Actualmente soportado:
# CURRENT_AND_PREVIOUS
Progression.Battlegrounds.Policy = CURRENT_AND_PREVIOUS

# Máximo de batallas automáticas por cada bracket configurado.
Progression.Battlegrounds.InstancesPerBracket = 1

#
# LFG / DUNGEON AUTOMATION
#

# Los randombots pueden utilizar Dungeon Finder.
# AzerothCore decide las mazmorras disponibles según
# los requisitos normales de nivel.
Progression.LFG.Enabled = 1
